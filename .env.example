# Azure DevOps organization URL, e.g. https://dev.azure.com/myorg
ADO_ORG_URL=

# Personal Access Token with Work Items (Read) scope
ADO_PAT=

# Optional: comma-separated project names to limit sync scope (default: all projects)
# PROJECTS=ProjectA,ProjectB

# GitHub personal access token (classic: repo scope; fine-grained: Issues and Pull requests read)
GH_TOKEN=

# Optional: comma-separated repositories to limit GitHub sync scope (default: all repos you are involved in)
# GH_REPOS=owner/repo,another/repo

# Optional: GitHub Enterprise host (default: github.com)
# GH_HOST=github.example.com

# Optional: port for the local server (default: 4073)
# PORT=4073

# Optional: days without update before an open item counts as "needs attention" (default: 14)
# STALE_DAYS=14

# Optional: how far back the first sync deep-scans for your edits/comments (default: 365)
# LOOKBACK_DAYS=365
